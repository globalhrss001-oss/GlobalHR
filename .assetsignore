# Files Cloudflare Workers/Pages should NOT upload as static assets.
# Excludes version-control internals (the .git pack exceeds the 25 MiB asset limit)
# and other non-website files.
.git/
.gitignore
.assetsignore
wrangler.toml
*.log
samples/
scripts/
README.md
assets/images/new images/
# Single files over Cloudflare's 25 MiB static asset limit — host video via YouTube/Drive instead
assets/media/news/news-exhibition-labor-minister-2026/exhibition-video.mp4
