# Files Cloudflare Workers/Pages should NOT upload as static assets.
# Excludes version-control internals (the .git pack exceeds the 25 MiB asset limit)
# and other non-website files.
.git/
.gitignore
.assetsignore
wrangler.toml
*.log
samples/
scripts/
tools/
README.md
TECHNICAL.md
TECHNICAL.pdf
USER-GUIDE.md
USER-GUIDE.pdf
assets/images/new images/
